# Environment variables — keep your Beehiiv Publication ID off GitHub
.env

# Generated local config — created from .env by running: source .env && echo "window.BEEHIIV_PUB_ID='pub_$BEEHIVE_ID'; window.GOATCOUNTER_CODE='$GOATCOUNTER_CODE';" > config.js
config.js

# TIMPS font source files (large TTF binaries — keep the smaller WOFF2 copies)
TIMPS-Family-v2/*.ttf

# Python cache
__pycache__/
*.pyc

# Standalone scripts (not part of the site build)
send_to_beehiiv.py
convert_issues.py

# macOS
.DS_Store

# Node.js
node_modules/

# new-style source (keep only out/ thumbnails)
new-style/node_modules/
new-style/*.js
new-style/package*.json
new-style/*.md
new-style/*.png

/.claude
